{
        "manifest_version": 3,
        "name": "sm2lc wasm extension",
        "version": "1.0",
        "description": "Use rust in wasm extension to make doing neetcodes easy",
        "action": {
                "default_popup": "popup.html"
        },
        "background" : {
          "scripts" : "background.js"
        },
        "content_security_policy": {
          "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
        }
}
